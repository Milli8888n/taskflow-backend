<%- include('../partials/_header', { title: 'Thông báo | TaskFlow' }) %>
<%- include('../partials/_sidebar', { activePage: 'notifications' }) %>
<%- include('../partials/_topbar') %>

<main class="main-content-wrapper pt-16 min-h-screen bg-background transition-all duration-300">
    <div class="px-6 py-8 lg:px-12 max-w-4xl mx-auto space-y-10">
        
        <!-- Page Header (Premium Floating Style) -->
        <header class="flex items-center justify-between gap-6 px-10 py-8 glass-panel rounded-[2.5rem] border border-outline-variant/10 shadow-2xl relative overflow-hidden group">
            <div class="absolute inset-0 bg-gradient-to-r from-primary/5 via-transparent-to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
            <div class="flex items-center gap-8 relative z-10">
                <div class="w-16 h-16 rounded-[1.5rem] bg-primary/10 flex items-center justify-center text-primary shadow-inner">
                    <span class="material-symbols-outlined text-4xl">notifications_active</span>
                </div>
                <div>
                    <h1 class="text-4xl font-black tracking-tight text-on-surface font-headline italic">Thông báo</h1>
                    <div class="flex items-center gap-3 mt-2">
                        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                        <span class="text-[10px] font-black text-on-surface-variant uppercase tracking-[0.2em] opacity-60">Cập nhật mới nhất từ workspace</span>
                    </div>
                </div>
            </div>
            
            <button id="mark-all-btn" class="relative z-10 p-4 rounded-2xl bg-surface-container/50 border border-outline-variant/10 hover:bg-surface-container-highest transition-all group/btn" title="Đánh dấu đã đọc">
                <span class="material-symbols-outlined text-2xl text-on-surface-variant group-hover/btn:text-primary transition-all">checklist</span>
            </button>
        </header>

        <div class="space-y-3" id="notifications-list">
            <!-- Loading state -->
            <div class="text-center py-24" id="notifications-loading">
                <span class="material-symbols-outlined text-4xl text-primary animate-spin">sync</span>
                <p class="text-on-surface-variant font-bold mt-4 opacity-70">Đang tải thông báo...</p>
            </div>
        </div>
    </div>
</main>

<script type="module" src="/js/pages/notifications.js"></script>

<%- include('../partials/_footer') %>
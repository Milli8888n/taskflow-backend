<!DOCTYPE html>
<html class="dark" lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title != 'undefined' ? title : 'TaskFlow' %></title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Material Symbols Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <!-- Tailwind CSS CDN + Plugins -->
    <!-- ⚠️ NOTE: CDN should only be used for development/prototyping -->
    <!-- For production, install Tailwind CSS and use PostCSS: -->
    <!-- npm install -D tailwindcss postcss autoprefixer -->
    <!-- npx tailwindcss init -p -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <!-- Stitch Design Tokens (REQUIRED) -->
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#c3c0ff",
                        "primary-container": "#544bea",
                        "on-primary": "#1d00a5",
                        "on-primary-container": "#e2dfff",
                        "secondary": "#b7c8e1",
                        "secondary-container": "#3a4a5f",
                        "on-secondary": "#213145",
                        "on-secondary-container": "#a9bad3",
                        "tertiary": "#4edea3",
                        "tertiary-container": "#00734e",
                        "on-tertiary": "#003824",
                        "on-tertiary-container": "#6efbbd",
                        "error": "#ffb4ab",
                        "error-container": "#93000a",
                        "on-error": "#690005",
                        "on-error-container": "#ffdad6",
                        "surface": "#12131b",
                        "surface-dim": "#12131b",
                        "surface-bright": "#383842",
                        "surface-container-lowest": "#0d0e16",
                        "surface-container-low": "#1a1b24",
                        "surface-container": "#1e1f28",
                        "surface-container-high": "#292932",
                        "surface-container-highest": "#34343e",
                        "on-surface": "#e3e1ee",
                        "on-surface-variant": "#c5c5d8",
                        "on-background": "#e3e1ee",
                        "background": "#12131b",
                        "outline": "#8f8fa1",
                        "outline-variant": "#444655",
                        "inverse-surface": "#e3e1ee",
                        "inverse-on-surface": "#2f3039",
                        "inverse-primary": "#4d44e3",
                        "surface-tint": "#c3c0ff",
                        "surface-variant": "#34343e",
                    },
                    borderRadius: {
                        DEFAULT: "0.125rem",
                        lg: "0.25rem",
                        xl: "0.5rem",
                        full: "0.75rem",
                    },
                    fontFamily: {
                        headline: ["Manrope", "sans-serif"],
                        body: ["Inter", "sans-serif"],
                        label: ["Inter", "sans-serif"],
                    },
                    animation: {
                        "gradient-shift": "gradientShift 6s ease infinite",
                        "float": "float 3s ease-in-out infinite",
                        "glow-pulse": "glowPulse 3s ease-in-out infinite",
                    },
                    keyframes: {
                        gradientShift: {
                            "0%": { backgroundPosition: "0% 50%" },
                            "50%": { backgroundPosition: "100% 50%" },
                            "100%": { backgroundPosition: "0% 50%" },
                        },
                        float: {
                            "0%, 100%": { transform: "translateY(0)" },
                            "50%": { transform: "translateY(-10px)" },
                        },
                        glowPulse: {
                            "0%, 100%": { boxShadow: "0 0 20px rgba(195, 192, 255, 0.3)" },
                            "50%": { boxShadow: "0 0 30px rgba(195, 192, 255, 0.6)" },
                        },
                    },
                },
            },
        }
    </script>

    <!-- Stitch Base Styles + Utility Classes -->
    <style>
        /* ==================== MATERIAL SYMBOLS CONFIGURATION ==================== */
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            display: inline-block;
            vertical-align: middle;
        }

        /* ==================== BASE TYPOGRAPHY & COLORS ==================== */
        :root {
            --surface-container-low-rgb: 26, 27, 36;
            --surface-container-high-rgb: 36, 37, 48;
            --outline-variant-rgb: 68, 70, 85;
            --primary-rgb: 62, 82, 232;
            --on-primary: #ffffff;
            --tertiary-rgb: 3, 218, 197;
        }

        html {
            font-size: 14px;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #0f1016;
            color: #ececf1;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5, h6, .font-headline {
            font-family: 'Manrope', sans-serif;
            letter-spacing: -0.02em;
        }

        /* ==================== GLOBAL PREMIUM UTILITIES ==================== */
        .glass-panel {
            background: rgba(var(--surface-container-low-rgb), 0.5);
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
            border: 1px solid rgba(var(--outline-variant-rgb), 0.1);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-panel:hover {
            background: rgba(var(--surface-container-low-rgb), 0.6);
            border-color: rgba(var(--primary-rgb), 0.2);
            transform: translateY(-2px);
            box-shadow: 0 12px 40px 0 rgba(0, 0, 0, 0.4);
        }

        .main-content-wrapper {
            margin-left: var(--sidebar-width, 16rem);
            transition: margin-left var(--sidebar-transition, 0.4s) cubic-bezier(0.4, 0, 0.2, 1);
            min-height: 100vh;
        }

        body.sidebar-is-collapsed .main-content-wrapper {
            margin-left: var(--sidebar-collapsed-width, 5rem);
        }

        /* ==================== SIDEBAR COLLAPSE LOGIC ==================== */
        #main-sidebar.sidebar-collapsed {
            width: 5rem !important;
        }

        #main-sidebar.sidebar-collapsed .sidebar-label {
            opacity: 0;
            pointer-events: none;
            width: 0;
            display: none;
        }

        #main-sidebar.sidebar-collapsed nav a,
        #main-sidebar.sidebar-collapsed .mt-auto a {
            justify-content: center;
            padding-left: 0;
            padding-right: 0;
        }

        #main-sidebar.sidebar-collapsed #sidebar-toggle {
            margin: 0 auto;
        }

        /* Topbar shifts with sidebar */
        body.sidebar-is-collapsed .topbar-wrapper {
            left: 5rem !important;
        }

        @media (max-width: 768px) {
            .main-content-wrapper {
                margin-left: 0 !important;
            }
            .topbar-wrapper {
                left: 0 !important;
            }
            #main-sidebar {
                display: none !important;
            }
        }

        /* ==================== CUSTOM SCROLLBAR (WEBKIT) ==================== */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #12131b;
        }
        ::-webkit-scrollbar-thumb {
            background: #34343e;
            border-radius: 10px;
            transition: background 0.3s ease;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #444655;
        }

        /* ==================== KINETIC GRADIENT - ANIMATED BACKGROUNDS ==================== */
        /* Animated gradient background for hero sections & elements */
        .kinetic-gradient {
            background: linear-gradient(135deg,
                #c3c0ff 0%,
                #544bea 25%,
                #4edea3 50%,
                #544bea 75%,
                #c3c0ff 100%);
            background-size: 400% 400%;
            animation: gradientShift 8s ease infinite;
        }

        /* Glow text effect with moving gradient */
        .kinetic-glow {
            background: linear-gradient(90deg,
                #c3c0ff,
                #4edea3,
                #c3c0ff);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: gradientShift 3s ease infinite;
        }

        /* ==================== GLASS PANEL EFFECTS - GLASS MORPHISM ==================== */
        /* Glass Morphism Card Container */
        .glass-panel {
            background: rgba(26, 27, 36, 0.6);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border: 1px solid rgba(197, 197, 216, 0.15);
            transition: all 0.3s ease;
        }
        .glass-panel:hover {
            background: rgba(26, 27, 36, 0.8);
            border-color: rgba(197, 197, 216, 0.25);
            box-shadow: 0 8px 32px rgba(195, 192, 255, 0.1);
        }

        /* Glass Blur - Strong frosted effect (default) */
        .glass-blur {
            background: rgba(18, 19, 27, 0.8);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(197, 197, 216, 0.1);
        }

        /* Glass Blur Light - Subtle blur for overlays */
        .glass-blur-light {
            background: rgba(26, 27, 36, 0.4);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            border: 1px solid rgba(197, 197, 216, 0.05);
        }

        /* Glass Blur Strong - Maximum blur effect for modal backdrops */
        .glass-blur-strong {
            background: rgba(18, 19, 27, 0.95);
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
            border: 1px solid rgba(195, 192, 255, 0.2);
        }

        /* ==================== GLOW & SHADOW EFFECTS ==================== */
        /* Glow shadow for interactive elements */
        .glow-sm {
            box-shadow: 0 0 15px rgba(195, 192, 255, 0.15);
        }
        .glow-md {
            box-shadow: 0 0 25px rgba(195, 192, 255, 0.25);
        }
        .glow-lg {
            box-shadow: 0 0 40px rgba(195, 192, 255, 0.35);
        }
        .glow-xl {
            box-shadow: 0 0 60px rgba(195, 192, 255, 0.45);
        }

        /* Primary color glow */
        .glow-primary {
            box-shadow: 0 0 20px rgba(195, 192, 255, 0.4);
        }
        .glow-primary-container {
            box-shadow: 0 0 20px rgba(84, 75, 234, 0.4);
        }
        .glow-tertiary {
            box-shadow: 0 0 20px rgba(78, 222, 163, 0.4);
        }

        /* ==================== FLOATING & ANIMATION EFFECTS ==================== */
        /* Float animation for cards & elements */
        .float {
            animation: float 3s ease-in-out infinite;
        }

        /* Pulse glow animation */
        .glow-pulse {
            animation: glowPulse 3s ease-in-out infinite;
        }

        /* ==================== UTILITY CLASSES ==================== */
        /* For selecting text with primary color */
        ::selection {
            background-color: rgba(195, 192, 255, 0.3);
            color: #e3e1ee;
        }

        /* Smooth transitions for interactive elements */
        button, a, input, select, textarea {
            transition: all 0.3s ease;
        }        /* ==================== SIDEBAR LAYOUT ==================== */
        :root {
            --sidebar-width: 16rem; /* w-64 */
            --sidebar-collapsed-width: 5rem; /* w-20 */
            --sidebar-transition: 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        #main-sidebar {
            width: var(--sidebar-width);
            transition: width var(--sidebar-transition), padding var(--sidebar-transition), transform var(--sidebar-transition);
        }

        #main-sidebar.sidebar-collapsed {
            width: var(--sidebar-collapsed-width);
            padding-left: 0.5rem;
            padding-right: 0.5rem;
        }

        /* Hide labels when collapsed */
        #main-sidebar.sidebar-collapsed .sidebar-label {
            opacity: 0;
            pointer-events: none;
            width: 0;
            overflow: hidden;
            margin: 0;
        }

        /* Main Content & Topbar synchronization */
        .main-content-wrapper,
        .topbar-wrapper {
            transition: all var(--sidebar-transition);
        }

        .main-content-wrapper {
            margin-left: var(--sidebar-width);
        }

        .topbar-wrapper {
            left: var(--sidebar-width) !important;
        }

        /* Collapsed States */
        body.sidebar-is-collapsed .main-content-wrapper {
            margin-left: var(--sidebar-collapsed-width);
        }

        body.sidebar-is-collapsed .topbar-wrapper {
            left: var(--sidebar-collapsed-width) !important;
        }

        /* Responsive override: on mobile sidebar is hidden, so margin 0 */
        @media (max-width: 768px) {
            .main-content-wrapper {
                margin-left: 0 !important;
            }
            .topbar-wrapper {
                left: 0 !important;
            }
            #main-sidebar {
                transform: translateX(-100%);
            }
        }
    </style>

    <!-- Custom CSS (nếu có) -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-background text-on-background font-body antialiased selection:bg-primary/30">
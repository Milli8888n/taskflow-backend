<aside id="main-sidebar" class="hidden md:flex flex-col h-screen w-64 glass-panel fixed left-0 top-0 py-5 px-3 z-50 transition-all duration-300 border-r border-outline-variant/10 rounded-none">

    <!-- Logo + Toggle -->
    <div class="flex items-center justify-between mb-8 px-2 overflow-hidden">
        <div class="flex items-center gap-3 shrink-0">
            <div class="w-9 h-9 rounded-xl bg-primary flex items-center justify-center shrink-0 shadow-lg shadow-primary/20">
                <span class="material-symbols-outlined text-on-primary text-lg">token</span>
            </div>
            <div class="sidebar-label transition-opacity duration-200">
                <h2 class="text-sm font-black text-on-surface leading-tight whitespace-nowrap tracking-tight">TaskFlow</h2>
                <p class="text-[9px] font-bold text-on-surface-variant/40 uppercase tracking-widest whitespace-nowrap">workspace</p>
            </div>
        </div>
        
        <button id="sidebar-toggle" class="w-8 h-8 rounded-lg flex items-center justify-center hover:bg-surface-container-high text-on-surface-variant/50 transition-colors">
            <span class="material-symbols-outlined text-lg" id="toggle-icon">keyboard_double_arrow_left</span>
        </button>
    </div>

    <!-- Main Nav -->
    <nav class="flex-1 space-y-0.5">
        <a href="/dashboard" class="flex items-center gap-3 px-4 py-2.5 rounded-xl
            <%= typeof activePage !== 'undefined' && activePage === 'dashboard'
                ? 'bg-primary/10 text-primary font-black'
                : 'text-on-surface-variant/60 hover:bg-surface-container-high hover:text-on-surface'
            %> transition-all duration-200">
            <span class="material-symbols-outlined text-xl">grid_view</span>
            <span class="text-xs tracking-wide sidebar-label transition-opacity duration-200 font-bold uppercase">Bảng điều khiển</span>
        </a>

        <a href="/projects" class="flex items-center gap-3 px-4 py-2.5 rounded-xl
            <%= typeof activePage !== 'undefined' && activePage === 'projects'
                ? 'bg-primary/10 text-primary font-black shadow-[inset_0_0_20px_rgba(var(--primary-rgb),0.05)]'
                : 'text-on-surface-variant/60 hover:bg-surface-container-high/40 hover:text-on-surface'
            %> transition-all duration-300 group">
            <span class="material-symbols-outlined text-xl group-hover:scale-110 transition-transform">assignment</span>
            <span class="text-xs tracking-wide sidebar-label transition-opacity duration-200 font-bold uppercase">Dự án</span>
        </a>

        <a href="/notifications" class="flex items-center gap-3 px-4 py-2.5 rounded-xl
            <%= typeof activePage !== 'undefined' && activePage === 'notifications'
                ? 'bg-primary/10 text-primary font-black'
                : 'text-on-surface-variant/60 hover:bg-surface-container-high hover:text-on-surface'
            %> transition-all duration-200">
            <span class="material-symbols-outlined text-xl">notifications</span>
            <span class="text-xs tracking-wide sidebar-label transition-opacity duration-200 font-bold uppercase">Thông báo</span>
        </a>

        <a href="javascript:alert('Tính năng Nhóm đang phát triển');" class="flex items-center gap-3 px-4 py-2.5 rounded-xl
            <%= typeof activePage !== 'undefined' && activePage === 'team'
                ? 'bg-primary/10 text-primary font-black'
                : 'text-on-surface-variant/60 hover:bg-surface-container-high hover:text-on-surface'
            %> transition-all duration-200">
            <span class="material-symbols-outlined text-xl">group</span>
            <span class="text-xs tracking-wide sidebar-label transition-opacity duration-200 font-bold uppercase">Nhóm</span>
        </a>
    </nav>

    <!-- Footer -->
    <div class="mt-auto space-y-0.5 pt-4 border-t border-outline-variant/10">
        <a href="javascript:alert('Tính năng Hỗ trợ đang phát triển');" class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-on-surface-variant/60 hover:bg-surface-container-high hover:text-on-surface transition-all">
            <span class="material-symbols-outlined text-xl">contact_support</span>
            <span class="text-xs tracking-wide sidebar-label transition-opacity duration-200 font-bold uppercase">Hỗ trợ</span>
        </a>
        <a href="#" id="sidebar-logout-link" class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-on-surface-variant/60 hover:bg-error/10 hover:text-error transition-all">
            <span class="material-symbols-outlined text-xl">logout</span>
            <span class="text-xs tracking-wide sidebar-label transition-opacity duration-200 font-bold uppercase">Đăng xuất</span>
        </a>
    </div>
</aside>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const sidebar = document.getElementById('main-sidebar');
    const toggleBtn = document.getElementById('sidebar-toggle');
    const toggleIcon = document.getElementById('toggle-icon');
    const body = document.body;

    const setSidebarState = (collapsed) => {
        if (collapsed) {
            sidebar.classList.add('sidebar-collapsed');
            body.classList.add('sidebar-is-collapsed');
            toggleIcon.innerText = 'keyboard_double_arrow_right';
        } else {
            sidebar.classList.remove('sidebar-collapsed');
            body.classList.remove('sidebar-is-collapsed');
            toggleIcon.innerText = 'keyboard_double_arrow_left';
        }
    };

    // Initialize from storage
    const isCollapsed = localStorage.getItem('sidebar-collapsed') === 'true';
    setSidebarState(isCollapsed);

    if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
            const nowCollapsed = sidebar.classList.toggle('sidebar-collapsed');
            body.classList.toggle('sidebar-is-collapsed', nowCollapsed);
            localStorage.setItem('sidebar-collapsed', nowCollapsed);
            toggleIcon.innerText = nowCollapsed ? 'keyboard_double_arrow_right' : 'keyboard_double_arrow_left';
        });
    }

    // Handle logout confirm
    const logoutLink = document.getElementById('sidebar-logout-link');
    if (logoutLink) {
        logoutLink.addEventListener('click', (e) => {
            e.preventDefault();
            if (confirm('Bạn có chắc chắn muốn đăng xuất?')) {
                window.location.href = '/auth/logout';
            }
        });
    }
});
</script>
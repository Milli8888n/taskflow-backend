<header class="fixed left-56 right-0 top-0 z-20 flex h-14 items-center gap-3 border-b border-slate-200 bg-white/95 px-4 backdrop-blur supports-[backdrop-filter]:bg-white/80" role="banner">
  <div class="relative min-w-0 max-w-xl flex-1">
    <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-[20px] text-slate-400 material-symbols-outlined" aria-hidden="true">search</span>
    <input
      type="search"
      name="q"
      class="w-full rounded-lg border border-slate-200 bg-slate-50 py-2 pl-10 pr-3 text-sm text-slate-800 placeholder:text-slate-400 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
      placeholder="Tìm task, dự án…"
      autocomplete="off"
      disabled
      aria-label="Tìm kiếm (tĩnh)"
    />
  </div>
  <div class="flex shrink-0 items-center gap-2">
    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-primary text-xs font-bold text-white shadow ring-2 ring-white" title="Người dùng" aria-hidden="true">TF</span>
  </div>
</header>

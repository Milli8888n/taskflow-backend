<!-- ===== TopNavBar (Premium Glass) ===== -->
<header class="topbar-wrapper fixed top-0 right-0 h-20 bg-background/40 backdrop-blur-3xl backdrop-saturate-200 flex justify-between items-center px-8 z-40 border-b border-outline-variant/10">
    <div class="absolute inset-0 bg-gradient-to-r from-primary/5 via-transparent to-transparent opacity-50 pointer-events-none"></div>
    <!-- Left: Search -->
    <div class="flex items-center gap-6">
        <div class="hidden lg:flex items-center glass-panel px-4 py-1.5 rounded-xl gap-2">
            <span class="material-symbols-outlined text-on-surface-variant/40 text-sm">search</span>
            <input type="text" placeholder="Tìm kiếm nhanh..." class="bg-transparent border-none focus:ring-0 text-xs font-medium text-on-surface placeholder:text-on-surface-variant/30 w-44 outline-none">
        </div>
    </div>

    <!-- Right: Actions -->
    <div class="flex items-center gap-3">
        <div class="flex items-center gap-1.5">
            <!-- Notification Dropdown -->
            <div class="relative group">
                <button class="p-2 text-on-surface-variant/60 hover:text-primary hover:bg-surface-container-high rounded-xl relative transition-all">
                    <span class="material-symbols-outlined text-xl">notifications</span>
                    <span id="notification-badge" class="absolute top-1.5 right-1.5 w-2 h-2 bg-primary rounded-full ring-2 ring-background" style="display: none;"></span>
                </button>
                <!-- Notification Popover -->
                <div class="absolute right-0 mt-2 w-[380px] glass-panel rounded-2xl shadow-2xl z-[60] overflow-hidden hidden group-focus-within:block group-hover:block transition-all duration-300">
                    <div class="flex items-center justify-between px-5 py-3.5 border-b border-outline-variant/10">
                        <h3 class="font-black text-on-surface text-xs uppercase tracking-widest">Thông báo</h3>
                        <button id="mark-all-read-btn" class="text-[9px] font-black text-primary/60 hover:text-primary transition-colors uppercase tracking-widest">Đánh dấu đã đọc</button>
                    </div>
                    <div id="notification-list" class="max-h-[400px] overflow-y-auto custom-scrollbar">
                        <div class="px-5 py-8 text-center opacity-50">
                            <span class="material-symbols-outlined text-3xl mb-2">hourglass_empty</span>
                            <p class="text-xs font-medium">Đang tải...</p>
                        </div>
                    </div>
                    <a class="block w-full py-3.5 text-center text-[10px] font-black text-on-surface-variant/50 hover:text-on-surface hover:bg-surface-container-high/20 transition-all border-t border-outline-variant/10 uppercase tracking-widest" href="/notifications">
                        Xem tất cả thông báo
                    </a>
                </div>
            </div>
            
            <button class="p-2 rounded-xl text-on-surface-variant/40 hover:text-on-surface hover:bg-surface-container-high transition-all">
                <span class="material-symbols-outlined text-xl">help</span>
            </button>
        </div>

        <!-- User Profile -->
        <a href="/profile" id="topbar-profile-link" class="w-10 h-10 rounded-xl bg-surface-container flex items-center justify-center hover:bg-surface-container-high transition-colors overflow-hidden border border-outline-variant/10 group">
            <div id="topbar-user-profile" class="w-full h-full flex items-center justify-center">
                <% if (typeof user !== 'undefined' && user) { %>
                    <% if (user.avatar) { %>
                        <img src="<%= user.avatar %>" alt="avatar" class="w-full h-full object-cover">
                    <% } else { %>
                        <span class="text-[10px] font-black text-primary"><%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %></span>
                    <% } %>
                <% } else { %>
                    <span class="material-symbols-outlined text-on-surface-variant text-sm">person</span>
                <% } %>
            </div>
        </a>
    </div>
</header>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // Sync Topbar with LocalStorage User Data
    const syncTopbarProfile = () => {
        const userData = localStorage.getItem('user');
        if (!userData) return;

        try {
            const user = JSON.parse(userData);
            const container = document.getElementById('topbar-user-profile');
            
            if (container && user) {
                if (user.avatar) {
                    const cacheBuster = `?t=${new Date().getTime()}`;
                    const avatarUrl = user.avatar.includes('?') ? `${user.avatar}&t=${new Date().getTime()}` : `${user.avatar}${cacheBuster}`;
                    container.innerHTML = `<img src="${avatarUrl}" alt="avatar" class="w-full h-full object-cover">`;
                } else if (user.name) {
                    container.innerHTML = `<span class="text-[10px] font-black text-primary">${user.name.charAt(0).toUpperCase()}</span>`;
                }
            }
        } catch (e) {
            console.error('Error syncing topbar profile:', e);
        }
    };

    syncTopbarProfile();
    
    // Listen for storage changes in other tabs
    window.addEventListener('storage', (e) => {
        if (e.key === 'user') syncTopbarProfile();
    });

    // Listen for profile updates in the current tab
    window.addEventListener('user-profile-updated', syncTopbarProfile);
});
</script>

<!-- Nạp Notification Box Logic -->
<script type="module" src="/js/components/notificationBox.js"></script>
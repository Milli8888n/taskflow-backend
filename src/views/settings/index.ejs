<%- include('../partials/_header', { title: 'Cài đặt | TaskFlow' }) %>
<%- include('../partials/_sidebar', { activePage: 'settings' }) %>
<%- include('../partials/_topbar') %>

<main class="main-content-wrapper pt-16 min-h-screen bg-background transition-all duration-300">
    <div class="px-6 py-8 lg:px-12 max-w-4xl mx-auto space-y-10">

        <!-- Header -->
        <header class="border-b border-outline-variant/10 pb-8">
            <h1 class="text-3xl font-black tracking-tight font-headline text-on-surface">Cài đặt Dự án</h1>
            <p class="text-on-surface-variant text-sm font-medium mt-1 opacity-70">Quản lý thông tin, thành viên và thiết lập của <span class="font-black text-on-surface"><%= project.name %></span></p>
        </header>

        <!-- Tab Navigation -->
        <div class="flex items-center gap-1 glass-panel p-1.5 rounded-2xl w-fit">
            <button class="px-6 py-2.5 rounded-xl text-xs font-black uppercase tracking-widest bg-primary text-on-primary transition-all" data-tab="activity">Cài đặt chung</button>
            <button class="px-6 py-2.5 rounded-xl text-xs font-black uppercase tracking-widest text-on-surface-variant hover:text-on-surface transition-all" data-tab="roles">Thành viên (<%= project.members.length %>)</button>
        </div>

        <!-- General Settings -->
        <section id="section-activity" class="space-y-6">
            <div class="glass-panel rounded-3xl p-8 space-y-6">
                <div class="flex items-center gap-3 mb-4">
                    <span class="material-symbols-outlined text-primary">settings</span>
                    <h3 class="text-sm font-black text-on-surface uppercase tracking-tight">Thông tin cơ bản</h3>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-1.5">
                        <label class="block text-[10px] font-black uppercase tracking-[0.2em] text-on-surface-variant/50">Tên dự án</label>
                        <input id="project-name-input" class="w-full bg-surface-container-high border border-outline-variant/15 rounded-xl px-4 py-3 text-sm text-on-surface focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all" type="text" value="<%= project.name %>" />
                    </div>
                    <div class="space-y-1.5">
                        <label class="block text-[10px] font-black uppercase tracking-[0.2em] text-on-surface-variant/50">Mã dự án (ID)</label>
                        <input class="w-full bg-surface-container-high border border-outline-variant/5 rounded-xl px-4 py-3 text-sm text-on-surface-variant opacity-50 cursor-not-allowed" readonly type="text" value="<%= project._id %>" />
                    </div>
                </div>
                <div class="space-y-1.5">
                    <label class="block text-[10px] font-black uppercase tracking-[0.2em] text-on-surface-variant/50">Mô tả</label>
                    <textarea id="project-desc-input" class="w-full bg-surface-container-high border border-outline-variant/15 rounded-xl px-4 py-3 text-sm text-on-surface focus:border-primary focus:ring-4 focus:ring-primary/10 transition-all resize-none" rows="3"><%= project.description %></textarea>
                </div>
                <div class="flex justify-end pt-2">
                    <button id="btn-save-project" class="bg-primary text-on-primary px-8 py-3 rounded-xl font-black text-xs uppercase tracking-widest hover:shadow-[0_0_20px_rgba(var(--primary-rgb),0.3)] transition-all">Lưu thay đổi</button>
                </div>
            </div>
        </section>

        <!-- Team Access -->
        <section id="section-roles" class="space-y-6 hidden">
            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-primary">group</span>
                    <h3 class="text-sm font-black text-on-surface uppercase tracking-tight">Quản lý thành viên</h3>
                </div>
                <button onclick="alert('Tính năng mời thành viên sẽ có trong Sprint sau!')" class="flex items-center gap-2 bg-primary text-on-primary px-5 py-2.5 rounded-xl font-black text-[10px] uppercase tracking-widest hover:shadow-[0_0_15px_rgba(var(--primary-rgb),0.3)] transition-all">
                    <span class="material-symbols-outlined text-sm">person_add</span> Mời
                </button>
            </div>

            <div class="glass-panel rounded-3xl overflow-hidden">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-outline-variant/10">
                            <th class="px-6 py-4 text-[10px] font-black uppercase tracking-[0.15em] text-on-surface-variant/50">Thành viên</th>
                            <th class="px-6 py-4 text-[10px] font-black uppercase tracking-[0.15em] text-on-surface-variant/50">Vai trò</th>
                            <th class="px-6 py-4 text-[10px] font-black uppercase tracking-[0.15em] text-on-surface-variant/50">Email</th>
                            <th class="px-6 py-4"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/5">
                        <% project.members.forEach(member => { %>
                        <tr class="hover:bg-surface-container-high/30 transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-xl bg-primary-container flex items-center justify-center font-black text-on-primary-container text-xs">
                                        <%= member.name.charAt(0).toUpperCase() %>
                                    </div>
                                    <div class="text-sm font-bold text-on-surface"><%= member.name %></div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="px-3 py-1 rounded-lg text-[9px] font-black uppercase tracking-widest <%= project.owner._id.toString() === member._id.toString() ? 'bg-primary/10 text-primary' : 'bg-surface-container-highest text-on-surface-variant' %>">
                                    <%= project.owner._id.toString() === member._id.toString() ? 'Chủ dự án' : 'Thành viên' %>
                                </span>
                            </td>
                            <td class="px-6 py-4 text-xs font-medium text-on-surface-variant/60"><%= member.email %></td>
                            <td class="px-6 py-4 text-right">
                                <button class="p-2 text-on-surface-variant/40 hover:text-on-surface rounded-lg hover:bg-surface-container-high transition-all"><span class="material-symbols-outlined text-lg">more_vert</span></button>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Danger Zone -->
        <section class="space-y-6 pt-6">
            <div class="border-t border-error/20 pt-10">
                <div class="flex items-center gap-3 text-error mb-6">
                    <span class="material-symbols-outlined">warning</span>
                    <h3 class="text-sm font-black uppercase tracking-tight">Khu vực nguy hiểm</h3>
                </div>
                <div class="glass-panel border-error/20 rounded-3xl p-8 flex flex-col md:flex-row items-center justify-between gap-6">
                    <div class="space-y-1">
                        <h4 class="font-black text-on-surface text-sm">Xoá dự án <%= project.name %></h4>
                        <p class="text-[11px] font-medium text-on-surface-variant/50 max-w-lg">Thao tác này không thể hoàn tác. Toàn bộ dữ liệu dự án sẽ bị xoá vĩnh viễn.</p>
                    </div>
                    <button id="btn-delete-project" class="shrink-0 bg-error text-on-error px-8 py-3 rounded-xl font-black text-xs uppercase tracking-widest hover:shadow-[0_0_20px_rgba(239,68,68,0.3)] transition-all">
                        Xoá Dự Án
                    </button>
                </div>
            </div>
        </section>

        <div class="h-12"></div>
    </div>
</main>

<script type="module">
    import { updateProject, deleteProject } from '/js/services/project.js';

    document.addEventListener('DOMContentLoaded', () => {
        const tabs = document.querySelectorAll('[data-tab]');
        const sectionActivity = document.getElementById('section-activity');
        const sectionRoles = document.getElementById('section-roles');
        const btnSave = document.getElementById('btn-save-project');
        const btnDelete = document.getElementById('btn-delete-project');

        // Tab switching logic
        tabs.forEach(btn => {
            btn.addEventListener('click', (e) => {
                const targetTab = e.currentTarget.getAttribute('data-tab');
                tabs.forEach(b => b.className = "px-6 py-2.5 rounded-xl text-xs font-black uppercase tracking-widest text-on-surface-variant hover:text-on-surface transition-all");
                e.currentTarget.className = "px-6 py-2.5 rounded-xl text-xs font-black uppercase tracking-widest bg-primary text-on-primary transition-all";
                
                if (targetTab === 'activity') {
                    sectionActivity.classList.remove('hidden');
                    sectionRoles.classList.add('hidden');
                } else {
                    sectionActivity.classList.add('hidden');
                    sectionRoles.classList.remove('hidden');
                }
            });
        });

        // Save Project logic
        btnSave?.addEventListener('click', async () => {
            const name = document.getElementById('project-name-input').value.trim();
            const description = document.getElementById('project-desc-input').value.trim();
            const projectId = '<%= project._id %>';

            if (!name) return alert('Tên dự án không được để trống');

            try {
                btnSave.disabled = true;
                btnSave.textContent = 'Đang lưu...';
                await updateProject(projectId, { name, description });
                alert('Đã cập nhật dự án thành công!');
                window.location.reload();
            } catch (err) {
                alert('Lỗi: ' + err.message);
                btnSave.disabled = false;
                btnSave.textContent = 'Lưu thay đổi';
            }
        });

        // Delete Project logic
        btnDelete?.addEventListener('click', async () => {
            const projectId = '<%= project._id %>';
            const projectName = '<%= project.name %>';
            
            if (confirm(`Bạn có chắc chắn muốn xoá dự án "${projectName}"? Thao tác này KHÔNG THỂ hoàn tác.`)) {
                try {
                    btnDelete.disabled = true;
                    btnDelete.textContent = 'Đang xoá...';
                    await deleteProject(projectId);
                    alert('Đã xoá dự án thành công!');
                    window.location.href = '/projects';
                } catch (err) {
                    alert('Lỗi: ' + err.message);
                    btnDelete.disabled = false;
                    btnDelete.textContent = 'Xoá Dự Án';
                }
            }
        });
    });
</script>

<%- include('../partials/_footer') %>
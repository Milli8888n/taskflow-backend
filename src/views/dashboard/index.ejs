<%- include('../partials/_header', { title: 'Dashboard | TaskFlow' }) %>
<%- include('../partials/_sidebar', { activePage: 'dashboard' }) %>
<%- include('../partials/_topbar') %>

<main class="main-content-wrapper pt-16 min-h-screen bg-background transition-all duration-300">
  <div class="px-6 py-8 lg:px-12 max-w-[1600px] mx-auto space-y-10">
    
    <!-- Dashboard Header (Premium style matching Board) -->
    <header class="flex items-center justify-between gap-6 px-8 py-6 glass-panel rounded-[2.5rem] border border-outline-variant/10 shadow-2xl relative overflow-hidden group">
        <div class="absolute inset-0 bg-gradient-to-r from-primary/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
        <div class="flex items-center gap-6 relative z-10">
            <div class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center text-primary shadow-inner">
                <span class="material-symbols-outlined text-3xl">dashboard_customize</span>
            </div>
            <div>
                <h1 class="text-3xl font-black tracking-tighter text-on-surface font-headline italic">Workspace Stats</h1>
                <div class="flex items-center gap-3">
                    <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                    <span class="text-[10px] font-black text-on-surface-variant uppercase tracking-[0.2em] opacity-60">Chào buổi sáng, <%= (typeof user !== 'undefined' && user) ? user.name.split(' ')[0] : 'Admin' %></span>
                </div>
            </div>
        </div>
        
        <div class="flex items-center gap-3 relative z-10">
             <button class="p-3 rounded-2xl bg-surface-container/50 border border-outline-variant/10 hover:bg-surface-container-highest transition-all group/btn" title="Refresh Data" onclick="window.location.reload()">
                <span class="material-symbols-outlined text-xl text-on-surface-variant group-hover/btn:rotate-180 transition-transform duration-500">sync</span>
            </button>
            <a href="/projects" class="px-8 py-3.5 bg-primary text-on-primary text-[11px] font-black uppercase tracking-widest rounded-2xl hover:shadow-[0_12px_30px_rgba(var(--primary-rgb),0.4)] hover:-translate-y-1 active:scale-95 transition-all">
                Dự án mới
            </a>
        </div>
    </header>

    <!-- Stats Grid (Glass Style) -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5">
      <article class="glass-panel rounded-2xl p-6 relative overflow-hidden group">
        <div class="absolute -right-4 -top-4 w-12 h-12 bg-primary/5 rounded-full blur-xl group-hover:bg-primary/20 transition-all"></div>
        <p class="text-[10px] font-black uppercase tracking-widest text-on-surface-variant/60 mb-2">Dự án</p>
        <div class="flex items-end justify-between">
          <h3 id="stat-projects" class="text-3xl font-black text-on-surface font-headline italic">0</h3>
          <span class="material-symbols-outlined text-primary/40">folder</span>
        </div>
      </article>

      <article class="glass-panel rounded-2xl p-6 relative overflow-hidden group">
        <p class="text-[10px] font-black uppercase tracking-widest text-on-surface-variant/60 mb-2">Cần làm</p>
        <div class="flex items-end justify-between">
          <h3 id="stat-todo" class="text-3xl font-black text-on-surface font-headline italic">0</h3>
          <span class="material-symbols-outlined text-outline/40">list_alt</span>
        </div>
      </article>

      <article class="glass-panel rounded-2xl p-6 relative overflow-hidden group border-b-2 border-b-primary/30">
        <p class="text-[10px] font-black uppercase tracking-widest text-on-surface-variant/60 mb-2">Đang làm</p>
        <div class="flex items-end justify-between">
          <h3 id="stat-inprogress" class="text-3xl font-black text-primary font-headline italic">0</h3>
          <span class="material-symbols-outlined text-primary/40 animate-pulse">sync</span>
        </div>
      </article>

      <article class="glass-panel rounded-2xl p-6 relative overflow-hidden group border-b-2 border-b-tertiary/30">
        <p class="text-[10px] font-black uppercase tracking-widest text-on-surface-variant/60 mb-2">Hoàn thành</p>
        <div class="flex items-end justify-between">
          <h3 id="stat-done" class="text-3xl font-black text-tertiary font-headline italic">0</h3>
          <span class="material-symbols-outlined text-tertiary/40">verified_user</span>
        </div>
      </article>

      <article class="glass-panel rounded-2xl p-6 relative overflow-hidden group border-b-2 border-b-error/30">
        <p class="text-[10px] font-black uppercase tracking-widest text-on-surface-variant/60 mb-2">Trễ hạn</p>
        <div class="flex items-end justify-between">
          <h3 id="stat-overdue" class="text-3xl font-black text-error font-headline italic">0</h3>
          <span class="material-symbols-outlined text-error/40">warning</span>
        </div>
      </article>
    </section>

    <!-- Global Progress -->
    <section class="glass-panel rounded-3xl p-8 border border-outline-variant/10">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-primary-container flex items-center justify-center text-on-primary-container shadow-lg shadow-primary-container/20">
                <span class="material-symbols-outlined">analytics</span>
            </div>
            <div>
                 <h2 class="text-sm font-black text-on-surface uppercase tracking-tight">Tiến độ tổng quát</h2>
                 <p class="text-[10px] font-bold text-on-surface-variant/50">Toàn bộ workspace</p>
            </div>
        </div>
        <div class="text-right">
            <span id="progress-text" class="text-2xl font-black text-primary tracking-tighter italic">0%</span>
        </div>
      </div>
      <div class="w-full h-2 rounded-full bg-surface-container-high overflow-hidden">
        <div class="progress-bar h-full rounded-full bg-primary shadow-[0_0_15px_rgba(var(--primary-rgb),0.5)] transition-all duration-1000 ease-out" id="progress-bar" style="width: 0%"></div>
      </div>
    </section>

    <!-- Pending Invitations -->
    <section id="invitations-section" class="hidden">
      <div class="glass-panel rounded-3xl p-8 border border-outline-variant/10 border-l-4 border-l-primary">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center text-primary shadow-inner">
            <span class="material-symbols-outlined">mail</span>
          </div>
          <div>
            <h2 class="text-sm font-black text-on-surface uppercase tracking-tight">Lời mời tham gia</h2>
            <p class="text-[10px] font-bold text-on-surface-variant/50">Bạn có lời mời đang chờ xác nhận</p>
          </div>
          <span id="invitations-count" class="ml-auto px-3 py-1 rounded-full bg-primary text-on-primary text-xs font-black">0</span>
        </div>
        <div id="invitations-list" class="space-y-3">
          <!-- Dynamic invitation cards -->
        </div>
      </div>
    </section>

    <p id="dashboard-error" class="hidden text-error text-center text-xs font-bold bg-error/10 p-4 rounded-xl"></p>
  </div>
</main>

<script>
  window.__TF__ = window.__TF__ || {};
  window.__TF__.page = 'dashboard';
</script>
<script type="module" src="/js/pages/dashboard.js"></script>
<%- include('../partials/_footer') %>


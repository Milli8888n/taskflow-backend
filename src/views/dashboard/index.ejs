<%- include('../partials/_header', { title: 'Dashboard | TaskFlow' }) %>
<%- include('../partials/_sidebar', { activePage: 'dashboard' }) %>
<%- include('../partials/_topbar') %>

<main class="md:ml-64 pt-16 min-h-screen bg-background">
  <div class="p-6 lg:p-10 max-w-7xl mx-auto space-y-8">
    <section>
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight font-headline text-on-surface">Dashboard</h1>
      <p class="text-on-surface-variant mt-2">Tổng quan nhanh hiệu suất dự án và công việc.</p>
    </section>

    <section class="stats-grid grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-4">
      <article class="bg-surface-container-low rounded-xl border border-outline-variant/10 p-5">
        <p class="text-on-surface-variant text-sm">Dự án</p>
        <h3 id="stat-projects" class="text-3xl font-bold mt-2">0</h3>
      </article>

      <article class="bg-surface-container-low rounded-xl border border-outline-variant/10 p-5">
        <p class="text-on-surface-variant text-sm">To Do</p>
        <h3 id="stat-todo" class="text-3xl font-bold mt-2">0</h3>
      </article>

      <article class="bg-surface-container-low rounded-xl border border-outline-variant/10 p-5">
        <p class="text-on-surface-variant text-sm">In Progress</p>
        <h3 id="stat-inprogress" class="text-3xl font-bold mt-2">0</h3>
      </article>

      <article class="bg-surface-container-low rounded-xl border border-outline-variant/10 p-5">
        <p class="text-on-surface-variant text-sm">Done</p>
        <h3 id="stat-done" class="text-3xl font-bold mt-2">0</h3>
      </article>

      <article class="bg-surface-container-low rounded-xl border border-outline-variant/10 p-5">
        <p class="text-on-surface-variant text-sm">Trễ hạn</p>
        <h3 id="stat-overdue" class="text-3xl font-bold mt-2 text-error">0</h3>
      </article>
    </section>

    <section class="bg-surface-container-low rounded-xl border border-outline-variant/10 p-5">
      <div class="flex items-center justify-between mb-3">
        <h2 class="font-semibold text-on-surface">Tiến độ hoàn thành</h2>
        <span id="progress-text" class="text-sm font-semibold text-primary">0%</span>
      </div>
      <div class="w-full h-3 rounded-full bg-surface-container-high overflow-hidden">
        <div class="progress-bar h-full rounded-full bg-primary transition-all duration-700 ease-out" id="progress-bar" style="width: 0%"></div>
      </div>
    </section>

    <p id="dashboard-error" class="hidden text-error text-sm"></p>
  </div>
</main>

<script>
  window.__TF__ = window.__TF__ || {};
  window.__TF__.page = 'dashboard';
</script>
<script type="module" src="/js/pages/dashboard.js"></script>
<%- include('../partials/_footer') %>


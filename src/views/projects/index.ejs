<%- include('../partials/_header', { title: 'Dự án | TaskFlow' }) %>
<%- include('../partials/_sidebar', { activePage: 'projects' }) %>
<%- include('../partials/_topbar') %>

<main class="main-content-wrapper pt-16 min-h-screen bg-background transition-all duration-300">
    <div class="px-6 py-8 lg:px-12 max-w-[1440px] mx-auto space-y-10">

    <!-- Page Header (Premium Floating Style) -->
    <header class="flex items-center justify-between gap-6 px-10 py-8 glass-panel rounded-[2.5rem] border border-outline-variant/10 shadow-2xl relative overflow-hidden group">
        <div class="absolute inset-0 bg-gradient-to-r from-primary/5 via-transparent-to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
        <div class="flex items-center gap-8 relative z-10">
            <div class="w-16 h-16 rounded-[1.5rem] bg-primary/10 flex items-center justify-center text-primary shadow-inner">
                <span class="material-symbols-outlined text-4xl">folder_shared</span>
            </div>
            <div>
                <h1 class="text-4xl font-black tracking-tight text-on-surface font-headline italic">Trung tâm Dự án</h1>
                <div class="flex items-center gap-3 mt-2">
                    <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                    <span class="text-[10px] font-black text-on-surface-variant uppercase tracking-[0.2em] opacity-60">Quản lý không gian làm việc của bạn</span>
                </div>
            </div>
        </div>
        
        <button onclick="createNewProject()" class="relative z-10 flex items-center gap-3 bg-primary text-on-primary px-10 py-5 rounded-2xl font-black text-[11px] uppercase tracking-[0.2em] hover:shadow-[0_15px_40px_rgba(var(--primary-rgb),0.4)] hover:-translate-y-1 active:scale-95 transition-all outline-none">
            <span class="material-symbols-outlined text-xl">add</span>
            Khởi tạo ngay
        </button>
    </header>

        <!-- Project Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="projects-list">

            <!-- Loading state -->
            <div class="col-span-full text-center py-24" id="projects-loading">
                <div class="inline-block w-12 h-12 border-4 border-primary/20 border-t-primary rounded-full animate-spin"></div>
                <p class="text-on-surface-variant font-black text-[10px] uppercase tracking-[0.2em] mt-6">Đang truy vấn dữ liệu...</p>
            </div>

            <!-- Add Project Card (Premium Style) -->
            <div class="group cursor-pointer glass-panel overflow-hidden border-2 border-dashed border-outline-variant/20 hover:border-primary/50 hover:scale-[1.02] hover:shadow-[0_20px_50px_rgba(0,0,0,0.4)] transition-all duration-500 rounded-3xl p-8 flex flex-col items-center justify-center min-h-[300px] text-center relative" onclick="createNewProject()">
                <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                <div class="relative z-10 w-20 h-20 rounded-3xl bg-surface-container-high flex items-center justify-center mb-8 group-hover:scale-110 group-hover:bg-primary group-hover:text-on-primary group-hover:rotate-12 transition-all duration-500 shadow-xl shadow-black/20">
                    <span class="material-symbols-outlined text-4xl">add_circle</span>
                </div>
                <h3 class="relative z-10 font-black text-on-surface text-xl mb-3 font-headline uppercase tracking-tight">Khởi tạo Dự án</h3>
                <p class="relative z-10 text-on-surface-variant text-[11px] font-bold opacity-50 px-8 leading-relaxed">Tạo không gian làm việc chuyên nghiệp cho ý tưởng tiếp theo của bạn.</p>
            </div>

            <!-- Project Empty State -->
            <div class="col-span-full text-center py-20 hidden" id="projects-empty">
                <span class="material-symbols-outlined text-6xl text-outline/20">folder_off</span>
                <p class="text-on-surface-variant font-bold mt-4 opacity-40">Danh sách trống</p>
            </div>
        </div>

        <div class="text-error text-xs font-black text-center hidden bg-error/10 p-4 rounded-xl" id="projects-error"></div>
    </div>
</main>

<script>
    window.__TF__ = window.__TF__ || {};
    window.__TF__.page = 'projects-index';
</script>
<script type="module" src="/js/pages/projects.js"></script>
<%- include('../partials/_footer') %>